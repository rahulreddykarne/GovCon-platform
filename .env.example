DATABASE_URL=postgresql+psycopg://govcon:govcon@localhost:5432/govcon

# SAM.gov Get Opportunities Public API key (Account Details on SAM.gov).
# Verified 2026-09-26: GET https://api.sam.gov/opportunities/v2/search
# Auth is the api_key query parameter. Do not commit a real key.
SAM_API_KEY=

# SAM.gov Entity Management API uses the same SAM_API_KEY.
# Verified 2026-09-26: GET https://api.sam.gov/entity-information/v3/entities
# Lazy vendor lookup caches rows for SAM_VENDOR_CACHE_HOURS (default 24).
SAM_VENDOR_CACHE_HOURS=24

# AI providers - all optional
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# DeepSeek is the default high-volume analysis/drafting provider.
# Verified 2026-09-26 against https://api-docs.deepseek.com/ :
# Endpoint: POST https://api.deepseek.com/chat/completions (OpenAI-compatible)
# Current model ids are deepseek-flash (V4.1-Flash) and deepseek-v4-pro (V4-Pro-0813).
# Retired ids deepseek-chat and deepseek-reasoner must not be used.
# JSON output: response_format {"type": "json_object"}
# Left empty so a deployment sets the model explicitly.
DEEPSEEK_MODEL=
# Anthropic (Claude Messages API via the anthropic SDK). Empty = claude-opus-5.
# Refusal fallback opts claude-opus-5 / claude-fable-5 / claude-fable-5-1 into the
# server-side fallbacks beta; the model that answered is recorded on the analysis.
ANTHROPIC_MODEL=
ANTHROPIC_REFUSAL_FALLBACK=true
# OpenAI (Chat Completions). Empty = gpt-5.
OPENAI_MODEL=
# deepseek | anthropic | openai
AI_PRIMARY_PROVIDER=deepseek
AI_REVIEW_PROVIDER=
AI_SECONDARY_REVIEW_PROVIDER=

AI_EXTERNAL_ALLOWED_FOR_PROPRIETARY=false
AI_EXTERNAL_ALLOWED_FOR_FCI=false
AI_EXTERNAL_ALLOWED_FOR_CUI=false

# Prompt system
PROMPT_ROOT=./src/govcon/prompts
PROMPT_STRICT_JSON=true
PROMPT_FAIL_ON_SCHEMA_ERROR=true
PROMPT_ENABLE_REGRESSION_GATE=true
PROMPT_REQUIRE_BEHAVIORAL_EVALUATION=true
# Exact-candidate receipts produced by govcon prompts eval <name>@<version> --live.
# Defaults to DATA_DIR/prompt_evaluations; disabling this is offline bootstrap only.
PROMPT_BEHAVIORAL_EVIDENCE_DIR=
PROMPT_MAX_RETRIES_ON_INVALID_JSON=1

# Shared, durable budgets across all opportunity calls and retries. Input
# reservations use a conservative UTF-8 byte upper bound, settled from usage.
AI_MAX_INPUT_TOKENS_PER_OPPORTUNITY=120000
AI_MAX_INPUT_TOKENS_PER_CALL=48000
AI_MAX_OUTPUT_TOKENS_PER_CALL=8192
AI_MAX_PROVIDER_RETRIES=2
AI_MAX_COST_USD_PER_OPPORTUNITY=
# Required with a dollar cap: an operator-verified upper USD rate per million
# tokens covering input, output, caching and all enabled/fallback models.
AI_BUDGET_USD_PER_MILLION_TOKENS=
# Share (0-0.99) of each opportunity's budget kept for proposal drafting and review;
# preparation (summary, compliance, research, decision) may spend only the rest.
AI_PROPOSAL_BUDGET_SHARE=0.25

# OCR for PDF pages without a text layer (ADR-065). Needs the Tesseract binary:
#   Windows: winget install UB-Mannheim.TesseractOCR   Linux: apt install tesseract-ocr
# Leave TESSERACT_CMD blank to find it on PATH (or the Windows default folder).
# Without Tesseract those pages stay flagged as unreadable and block compliance.
OCR_ENABLED=true
TESSERACT_CMD=
OCR_LANG=eng
OCR_DPI=300
OCR_MAX_PAGES_PER_FILE=300
OCR_MIN_NATIVE_CHARS_PER_PAGE=20
# Where attachment bytes are stored. Only "local" exists: run every worker on
# the machine that holds DATA_DIR.
ATTACHMENT_STORE=local

# Our own SAM registration, refreshed daily by the midday job (ADR-072).
# Leave COMPANY_UEI blank to use "uei" from the COMPANY_FACTS_PATH file.
COMPANY_UEI=
SAM_EXPIRY_ALERT_DAYS=60
COMPANY_FACTS_MAX_AGE_DAYS=3

# Email each in-app notification to its user (ADR-070). Off by default because
# it sends mail; needs SMTP_HOST (same TLS rules as the digest).
NOTIFY_EMAIL_ENABLED=false
# Review reminders and escalations, run by the midday chain (ADR-070).
REVIEW_REMINDER_HOURS=48
REVIEW_OVERDUE_HOURS=96
REVIEW_ESCALATE_DAYS_BEFORE_DEADLINE=3

# Durable background tasks (run `govcon worker start` beside the web app).
# A worker that stops renewing its lease loses the task after this many
# seconds; another worker resumes it and the late result is discarded.
TASK_LEASE_SECONDS=300
TASK_DEFAULT_MAX_ATTEMPTS=5
TASK_RETRY_BASE_SECONDS=30
TASK_RETRY_MAX_SECONDS=3600
WORKER_POLL_SECONDS=2

# Structured decision service
# Verified 2026-09-26 contract probes (no key): JEV expects model/state/questions
# at POST /v1/systemone with Bearer auth. /v1/chat/completions is not valid.
JEV_ENABLED=true
JEV_API_KEY=
JEV_BASE_URL=
DECISION_PRIMARY_PROVIDER=jev
DECISION_FALLBACK_PROVIDER=rules
JEV_MIN_CONFIDENCE=
JEV_HUMAN_REVIEW_THRESHOLD=

# Compliance (Phase 9). Pass B defaults to AI_PRIMARY_PROVIDER; set a different
# provider/model to reduce shared omission risk (a run whose passes resolve to the
# same provider and model records a pass_b_not_independent warning). Escalation replaces Pass B for
# opportunities whose estimated_value_max >= COMPLIANCE_ESCALATION_MIN_VALUE.
# Confidence thresholds are uncalibrated and unset by default: AI-only
# validation then never auto-accepts (NEEDS_REVIEW instead).
COMPLIANCE_PASS_B_PROVIDER=
COMPLIANCE_PASS_B_MODEL=
COMPLIANCE_ESCALATION_PROVIDER=
COMPLIANCE_ESCALATION_MODEL=
COMPLIANCE_ESCALATION_MIN_VALUE=
COMPLIANCE_HIGH_CONFIDENCE_THRESHOLD=
COMPLIANCE_LOW_CONFIDENCE_THRESHOLD=
COMPLIANCE_MERGE_SIMILARITY=0.72
COMPLIANCE_POSSIBLE_DUPLICATE_SIMILARITY=0.4
COMPLIANCE_COVERAGE_MIN_OVERLAP=0.6
COMPLIANCE_COVERAGE_PARTIAL_OVERLAP=0.3
# JSON file of approved company facts (sam_registration_status,
# sam_expiration_date, socioeconomic {small_business: true, ...}).
# Absent facts stay UNKNOWN; they are never inferred.
COMPANY_FACTS_PATH=

# Email alerts. Digest uses SMTP when SMTP_HOST and ALERT_EMAIL_TO are both set.
# Otherwise govcon alerts digest writes HTML under OUTBOX_DIR.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# SMTP requires TLS: port 465, or STARTTLS on other ports (certificate verified).
# Set true only to allow an unencrypted relay on localhost/127.0.0.1/::1.
SMTP_ALLOW_PLAINTEXT_LOCAL_RELAY=false
ALERT_EMAIL_TO=
# Re-alert a match after a deadline_changed event newer than alerted_at.
# Set false to send only the first new-match digest.
ALERT_ON_MATERIAL_DEADLINE_CHANGE=true

EMBEDDING_MODEL=all-MiniLM-L6-v2
# Optional pinned model revision; resolved commits are recorded on vectors.
EMBEDDING_MODEL_REVISION=

DATA_DIR=./data
OUTBOX_DIR=./outbox
LOG_DIR=./logs

# Safety / cost controls
ATTACHMENT_MAX_MB=100
# Attachment downloads are HTTPS-only to public addresses; true allows plain http.
ATTACHMENT_ALLOW_HTTP=false
HTTP_USER_AGENT=govcon-platform/2.0

# USAspending award search is public and does not use an API key.
# Verified 2026-09-26: POST https://api.usaspending.gov/api/v2/search/spending_by_award/
# limit maximum is 100. Contract award types are A, B, C, and D.

# Seconds between DIBBS HTTP calls. Verified 2026-09-26: neither host publishes robots.txt.
# The client accepts the DoD consent banner, then downloads one index file per command.
DIBBS_REQUEST_INTERVAL_SECONDS=2

# Local app exposure. Public bind requires an explicit override.
WEB_BIND_HOST=127.0.0.1
WEB_BIND_ALLOW_PUBLIC=false
SESSION_TTL_HOURS=12
# Exact browser origin when hosted behind a reverse proxy (include nondefault ports).
WEB_PUBLIC_ORIGIN=
# Enable for HTTPS deployments; HTTPS requests/origins also enable this automatically.
WEB_SECURE_COOKIES=false
# Set a shared random secret across workers/restarts for stable CSRF tokens.
WEB_CSRF_SECRET=
LOGIN_ATTEMPT_LIMIT=10
LOGIN_ATTEMPT_WINDOW_SECONDS=300
# Development bootstrap only; registry denials and errors still fail closed.
PROMPT_ALLOW_DISK_FALLBACK=false

# MCP write tools act as exactly this user (pinned at server start). Leave blank
# to serve read-only tools. Approvals, human reviews, compliance overrides, and
# submission recording are not available over MCP.
MCP_ACTOR_EMAIL=
